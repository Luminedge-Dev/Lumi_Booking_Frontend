# Copy to .env.local for local development. Do not put real secrets in this file.
# On Netlify, set these in the site environment. NEXT_PUBLIC_* values are
# inlined at build time, so changing them requires a new build.

# Required. Backend origin, no trailing slash. The build fails if this is missing.
NEXT_PUBLIC_API_BASE_URL=https://NEW_BACKEND_ORIGIN

# Only needed if Google sign-in is enabled. The login/register pages call
# signIn("google"); production use is unconfirmed. NEXTAUTH_URL must be the Netlify
# site origin and the Google OAuth redirect must be registered for it.
NEXTAUTH_URL=https://NEW_FRONTEND_ORIGIN
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
