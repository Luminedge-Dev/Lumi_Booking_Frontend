# Copy to .env.local for local development. Do not put real secrets in this file.
# On Netlify, set these in the site environment. NEXT_PUBLIC_* values are
# inlined at build time, so changing them requires a new build.

# Required. Backend origin, no trailing slash. The build fails if this is missing.
NEXT_PUBLIC_API_BASE_URL=https://NEW_BACKEND_ORIGIN

# Only needed if Google sign-in is enabled. The Google buttons on the login and
# register pages are currently commented out, so NextAuth is not a reachable
# login path and the custom backend-JWT flow does the authenticating. If Google
# sign-in is re-enabled, NEXTAUTH_URL must be the FRONTEND site origin (for local
# development: the frontend port, not the API port) and the Google OAuth redirect
# must be registered for it. Logout does not depend on this value: it always
# navigates to /login on whatever origin serves the frontend.
NEXTAUTH_URL=https://NEW_FRONTEND_ORIGIN
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
